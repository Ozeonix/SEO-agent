APP_NAME="SEO & Ads Optimization Agent"
ENV=dev
BACKEND_CORS_ORIGINS='["http://localhost:5173"]'
DATABASE_URL="sqlite:///./seo_agent.db"
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
DEMO_MODE=true
APPROVAL_DEFAULT_MODE="manual"
SCHEDULER_DAILY_CRON="0 6 * * *"
SCHEDULER_WEEKLY_CRON="0 7 * * 1"
OAUTH_TOKEN_ENCRYPTION_KEY="replace-with-32-char-secret"
